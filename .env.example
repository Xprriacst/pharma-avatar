# cp .env.example .env && source .env
# Ne commite jamais .env : il est ignoré par .gitignore.

# https://aistudio.google.com/apikey
export GEMINI_API_KEY=

# https://elevenlabs.io/app/settings/api-keys
# Si tu actives "Restrict Key", coche au minimum text_to_speech et voices_read,
# sinon HeyGen renvoie "Invalid API key".
export ELEVENLABS_API_KEY=

# HeyGen > Settings > API
export HEYGEN_API_KEY=
